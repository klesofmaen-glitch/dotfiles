/* ============================================================
 *  Rofi — «Station» theme
 *  Та же палитра, что у waybar: ночной заснеженный вокзал.
 *  Ночь #0E1420, зимнее небо #7EC3EA, янтарь окон #E8A75A.
 *  Все поверхности — полностью непрозрачные.
 * ============================================================ */

* {
    /* ---------- Токены (из обоев, непрозрачные) ---------- */
    space:          #0E1420;  /* surface — ночь               */
    space-high:     #16243C;  /* surface-high                 */
    space-bright:   #1E3050;  /* surface-bright               */
    primary:        #7EC3EA;  /* зимнее небо                  */
    on-surface:     #DCE6F2;  /* снег — основной текст        */
    on-variant:     #8898B4;  /* приглушённый текст (тени)    */
    tertiary:       #E8A75A;  /* тёплый свет окон             */
    error:          #FF9E8A;  /* хвостовые огни               */
    /* state-layer: 12% primary */
    state:          rgba(126, 195, 234, 0.12);

    background-color: transparent;
    text-color:       @on-surface;
    margin:           0px;
    padding:          0px;
    spacing:          0px;
}

/* ---------- Окно: монолитная карточка по центру ---------- */

window {
    background-color: @space;
    border-radius:    18px;
    width:            950px;
    padding:          14px;
    location:         center;
}

mainbox {
    spacing: 12px;
    children: [ banner, inputbar, listview, mode-switcher ];
}

/* ---------- Баннер из обоев (тонкая полоса с вокзалом) ---------- */

banner {
    expand:           false;
    padding:          42px;
    background-image: url("/home/resets/mpp/111.png", width);
    border-radius:    12px;
}

/* ---------- Строка поиска (M3 filled text field) ---------- */

inputbar {
    background-color: @space-high;
    border-radius:    14px;
    padding:          12px 16px;
    spacing:          12px;
    children:         [ prompt, entry ];
}

prompt {
    text-color:       @primary;
    font:             "Symbols Nerd Font 14";
    vertical-align:   0.5;
}

entry {
    placeholder:       "Поиск…";
    placeholder-color: @on-variant;
    text-color:        @on-surface;
    vertical-align:    0.5;
    blink:             true;
}

/* ---------- Список ---------- */

listview {
    lines:      8;
    columns:    1;
    spacing:    3px;
    scrollbar:  true;
    border:     0px;
    fixed-height: false;
}

scrollbar {
    handle-color:     @on-variant;
    handle-width:     3px;
    background-color: transparent;
    border-radius:    3px;
    margin:           0px 2px;
}

/* ---------- Элементы списка ---------- */

element {
    padding:          10px 14px;
    border-radius:    12px;
    background-color: transparent;
    spacing:          12px;
    transition:       150;
}

element normal.normal, element alternate.normal {
    background-color: transparent;
    text-color:       @on-surface;
}

/* State layer M3 на выбранном элементе */
element selected.normal {
    background-color: @state;
    text-color:       @primary;
}

element normal.urgent, element alternate.urgent {
    background-color: rgba(255, 158, 138, 0.10);
    text-color:       @error;
}

element selected.urgent {
    background-color: rgba(255, 158, 138, 0.18);
    text-color:       @error;
}

element normal.active, element selected.active {
    background-color: rgba(232, 167, 90, 0.14);
    text-color:       @tertiary;
}

element-icon {
    size:             28px;
    vertical-align:   0.5;
}

element-text {
    text-color:       inherit;
    vertical-align:   0.5;
    /* подсветка совпадений fuzzy-поиска */
    highlight:        "bold #7EC3EA";
    background-color: transparent;
}

/* ---------- Переключатель режимов (M3 tabs) ---------- */

mode-switcher {
    spacing: 6px;
}

mode-switcher button {
    padding:          6px 14px;
    border-radius:    999px;             /* M3 pill */
    background-color: transparent;
    text-color:       @on-variant;
    font:             "JetBrains Mono Medium 11";
}

mode-switcher button selected {
    background-color: @state;
    text-color:       @primary;
}

/* ---------- Tooltip / сообщения ---------- */

message {
    background-color: @space-high;
    border-radius:    12px;
    padding:          10px;
}

textbox {
    text-color:       @on-surface;
    background-color: transparent;
}
